{
  "name": "mcserverless",
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify": "pnpm --filter @mcbroken/db db:generate && turbo run check-types lint test",
    "check-api": "tsx scripts/check-api-health.ts",
    "check-api:us": "tsx scripts/check-api-health.ts us",
    "check-api:europe": "tsx scripts/check-api-health.ts europe",
    "check-api:australia": "tsx scripts/check-api-health.ts australia",
    "invoke": "./scripts/invoke-local.sh",
    "deploy": "pnpm deploy:dev",
    "deploy:dev": "turbo run deploy:dev --filter=./apps/mc*",
    "deploy:staging": "pnpm deploy:dev",
    "deploy:production": "pnpm deploy:dev",
    "deploy:mcall": "turbo run deploy:dev --filter=@mcbroken/mcall",
    "deploy:mcus": "turbo run deploy:dev --filter=@mcbroken/mcus",
    "deploy:mcau": "turbo run deploy:dev --filter=@mcbroken/mcau"
  },
  "devDependencies": {
    "@mcbroken/eslint-config": "workspace:*",
    "@mcbroken/typescript-config": "workspace:*",
    "@types/aws-lambda": "8.10.162",
    "@types/node": "24.13.3",
    "eslint": "9.39.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "serverless": "4.40.0",
    "serverless-offline": "14.8.0",
    "tsx": "4.23.11",
    "turbo": "2.10.8",
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.20.0"
}
